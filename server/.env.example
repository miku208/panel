# MikuRemote VPS configuration
# Salin file ini: cp .env.example .env lalu isi nilainya.

# WAJIB. Secret panjang acak untuk signing JWT.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Kunci pribadi mode personal (v0.2.0): kedua APK memakai kunci yang sama
# untuk /api/private/device dan /api/private/session. Kosong = endpoint
# /api/private/* nonaktif. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PRIVATE_KEY=

# HTTP server bind (default sudah baik; tidak perlu TLS di sini —
# HTTPS/WSS diterminasi reverse proxy / cloudflared tunnel di depan server).
PORT=8787
HOST=0.0.0.0

# SQLite
DB_FILE=./data/mikuremote.db

# Token lifetime (detik)
USER_TOKEN_TTL=604800        # 7 hari
DEVICE_TOKEN_TTL=31536000    # 1 tahun

# Pairing
PAIRING_CODE_TTL=900         # kode pairing aktif 15 menit
PAIRING_MAX_ATTEMPTS=10

# Proteksi
MAX_WS_MESSAGE_BYTES=524288          # 512 KB untuk control JSON
MAX_BINARY_FRAME_BYTES=2097152       # 2 MB per frame binary (chunk encoder)
IDLE_TIMEOUT_MS=60000                # koneksi diam > 60s diputus
HEARTBEAT_INTERVAL_MS=15000

# Rate limit
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=10
PAIRING_RATE_WINDOW_MS=60000
PAIRING_RATE_MAX=5

# Set 1 jika menjalankan di belakang reverse proxy (nginx/cloudflared)
TRUST_PROXY=1

# Logging: info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------
# CONTOH cloudflared tunnel untuk https://ashimusic.biz.id
# ( jalankan di VPS: cloudflared tunnel run mikuremote )
# ---------------------------------------------------------------
# ~/.cloudflared/config.yml:
#   tunnel: <tunnel-id>
#   credentials-file: /etc/cloudflared/<tunnel-id>.json
#   ingress:
#     - hostname: ashimusic.biz.id
#       service: http://localhost:8787
#     - service: http_status:404
#
# Di DNS Cloudflare: CNAME ashimusic.biz.id -> <tunnel-id>.cfargotunnel.com
# (cloudflared otomatis mendukung WebSocket; tidak ada config tambahan.)
